<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
		<RootNamespace>Drover.App</RootNamespace>
		<AssemblyName>Drover.App</AssemblyName>
		<ApplicationIcon>Resources\Icons\drover-idle.ico</ApplicationIcon>
		<Version>0.1.0</Version>
		<StartupObject>Drover.App.Program</StartupObject>
	</PropertyGroup>

	<ItemGroup>
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>

	<!-- Suppress the SDK's auto-generated Main so Program.Main can run Velopack
	     hooks before WPF spins up. App.xaml is still compiled (as a Page) so
	     InitializeComponent() works as usual. -->
	<ItemGroup>
		<ApplicationDefinition Remove="App.xaml" />
		<Page Include="App.xaml" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.7" />
		<PackageReference Include="Microsoft.Terminal.Wpf" Version="1.24.260303001" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="AvalonEdit" Version="6.3.1.120" />
		<PackageReference Include="Microsoft.Windows.Console.ConPTY" Version="1.24.260303001" />
		<PackageReference Include="SharpVectors" Version="1.8.5" />
		<PackageReference Include="Velopack" Version="0.0.1298" />
	</ItemGroup>
	<ItemGroup>
		<Content Include="$(MSBuildThisFileDirectory)..\..\References\Microsoft.Terminal.Control.dll">
			<Link>Microsoft.Terminal.Control.dll</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<Target Name="VerifyTerminalControlPresent" BeforeTargets="PrepareForBuild">
		<Error Condition="!Exists('$(MSBuildThisFileDirectory)..\..\References\Microsoft.Terminal.Control.dll')" Text="Missing References\Microsoft.Terminal.Control.dll. Download the latest Microsoft.WindowsTerminal_*_x64.zip from https://github.com/microsoft/terminal/releases, extract Microsoft.Terminal.Control.dll, and place it in the repo's References\ folder." />
	</Target>

	<ItemGroup>
		<Resource Include="Resources\Icons\drover-idle.ico" />
		<Resource Include="Resources\Icons\drover-working.ico" />
		<Resource Include="Resources\Icons\drover-attention.ico" />
		<Resource Include="Resources\Icons\drover-inactive.ico" />
		<Resource Include="Resources\CheatSheet.md" />
		<Resource Include="Resources\WhatsNew.md" />
		<Resource Include="Resources\FileIcons\*.svg" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Templates\*.md" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Drover.Vault.Core\Drover.Vault.Core.csproj" />
		<!-- Build dependency only — the MCP exe is launched as a separate process by Claude
		     Code via .mcp.json (spec 0006); we never link against it. The post-build target
		     below copies the runtime files into vaultmcp/ next to Drover.App.exe. -->
		<ProjectReference Include="..\Drover.VaultMcp\Drover.VaultMcp.csproj"
		                  ReferenceOutputAssembly="false"
		                  SkipGetTargetFrameworkProperties="true"
		                  PrivateAssets="all"
		                  ExcludeAssets="all"
		                  Private="false" />
		<!-- Build dependency only — the indexer is launched as a separate process by
		     SkillsRepoCatalog.RefreshAsync. Same shape as VaultMcp above. -->
		<ProjectReference Include="..\Drover.SkillsIndexer\Drover.SkillsIndexer.csproj"
		                  ReferenceOutputAssembly="false"
		                  SkipGetTargetFrameworkProperties="true"
		                  PrivateAssets="all"
		                  ExcludeAssets="all"
		                  Private="false" />
	</ItemGroup>

	<!-- Stage Drover.VaultMcp.exe + its runtime dependencies into a vaultmcp/ subfolder in
	     OutDir so the deployed shape is `Drover.App.exe + vaultmcp/Drover.VaultMcp.exe`.
	     Keeps the binary cluster discoverable for spec 0006's .mcp.json writer. -->
	<Target Name="CopyVaultMcpToOutput" AfterTargets="Build">
		<PropertyGroup>
			<VaultMcpOutDir>$(MSBuildThisFileDirectory)..\Drover.VaultMcp\bin\$(Configuration)\net10.0\</VaultMcpOutDir>
		</PropertyGroup>
		<ItemGroup>
			<VaultMcpFiles Include="$(VaultMcpOutDir)Drover.VaultMcp.exe" />
			<VaultMcpFiles Include="$(VaultMcpOutDir)Drover.VaultMcp.dll" />
			<VaultMcpFiles Include="$(VaultMcpOutDir)Drover.VaultMcp.runtimeconfig.json" />
			<VaultMcpFiles Include="$(VaultMcpOutDir)Drover.Vault.Core.dll" />
		</ItemGroup>
		<Copy SourceFiles="@(VaultMcpFiles)"
		      DestinationFolder="$(OutDir)vaultmcp\"
		      SkipUnchangedFiles="true"
		      Condition="Exists('%(FullPath)')" />
	</Target>

	<!-- Stage drover-skills-indexer.exe + its runtime files alongside Drover.App.exe
	     so SkillsRepoCatalog.LocateIndexerExecutable() finds it as a sibling. -->
	<Target Name="CopySkillsIndexerToOutput" AfterTargets="Build">
		<PropertyGroup>
			<SkillsIndexerOutDir>$(MSBuildThisFileDirectory)..\Drover.SkillsIndexer\bin\$(Configuration)\net10.0\</SkillsIndexerOutDir>
		</PropertyGroup>
		<ItemGroup>
			<SkillsIndexerFiles Include="$(SkillsIndexerOutDir)drover-skills-indexer.exe" />
			<SkillsIndexerFiles Include="$(SkillsIndexerOutDir)drover-skills-indexer.dll" />
			<SkillsIndexerFiles Include="$(SkillsIndexerOutDir)drover-skills-indexer.runtimeconfig.json" />
		</ItemGroup>
		<Copy SourceFiles="@(SkillsIndexerFiles)"
		      DestinationFolder="$(OutDir)"
		      SkipUnchangedFiles="true"
		      Condition="Exists('%(FullPath)')" />
	</Target>

	<!-- Publish-time equivalent: invoke Publish on Drover.VaultMcp into a known
	     folder, then mirror the result into vaultmcp/ next to the published
	     Drover.App.exe so the deployed shape matches the build-time layout. -->
	<Target Name="CopyVaultMcpToPublish" AfterTargets="Publish">
		<PropertyGroup>
			<VaultMcpPublishDir>$(MSBuildThisFileDirectory)..\Drover.VaultMcp\bin\$(Configuration)\net10.0\publish\</VaultMcpPublishDir>
		</PropertyGroup>
		<MSBuild Projects="..\Drover.VaultMcp\Drover.VaultMcp.csproj"
		         Targets="Publish"
		         Properties="Configuration=$(Configuration);TargetFramework=net10.0;PublishDir=$(VaultMcpPublishDir)" />
		<ItemGroup>
			<VaultMcpPublishedFiles Include="$(VaultMcpPublishDir)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(VaultMcpPublishedFiles)"
		      DestinationFolder="$(PublishDir)vaultmcp\%(RecursiveDir)"
		      SkipUnchangedFiles="true" />
	</Target>

	<Target Name="CopySkillsIndexerToPublish" AfterTargets="Publish">
		<PropertyGroup>
			<SkillsIndexerPublishDir>$(MSBuildThisFileDirectory)..\Drover.SkillsIndexer\bin\$(Configuration)\net10.0\publish\</SkillsIndexerPublishDir>
		</PropertyGroup>
		<MSBuild Projects="..\Drover.SkillsIndexer\Drover.SkillsIndexer.csproj"
		         Targets="Publish"
		         Properties="Configuration=$(Configuration);TargetFramework=net10.0;PublishDir=$(SkillsIndexerPublishDir)" />
		<ItemGroup>
			<SkillsIndexerPublishedFiles Include="$(SkillsIndexerPublishDir)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(SkillsIndexerPublishedFiles)"
		      DestinationFolder="$(PublishDir)%(RecursiveDir)"
		      SkipUnchangedFiles="true" />
	</Target>
</Project>

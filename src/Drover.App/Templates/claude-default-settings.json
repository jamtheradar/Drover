{
  "env": {
    "MAX_THINKING_TOKENS": "10000",
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet:*)",
      "Bash(dir:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(less:*)",
      "Bash(xxd:*)",
      "Bash(python:*)",
      "Bash(powershell -Command:*)",
      "Bash(powershell.exe -Command:*)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:nuget.org)",
      "Read(~/.nuget/**)"
    ],
    "deny": [
      "Read(./.vs/**)",
      "Edit(./.vs/**)",
      "Read(./.vscode/**)",
      "Edit(./.vscode/**)",
      "Read(./.git/**)",
      "Edit(./.git/**)",
      "Read(**/bin/**)",
      "Edit(**/bin/**)",
      "Read(**/obj/**)",
      "Edit(**/obj/**)",
      "Read(**/packages/**)",
      "Edit(**/packages/**)",
      "Read(**/*.user)",
      "Edit(**/*.user)",
      "Read(**/*.suo)",
      "Edit(**/*.suo)",
      "Bash(rm -rf *)",
      "Bash(del /F /Q *)",
      "Bash(git push:*)",
      "Bash(git checkout main)",
      "Bash(git checkout master)",
      "Bash(dotnet publish:*)",
      "Bash(sudo *)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~/*)",
      "Bash(chmod 777 *)",
      "Read(~/.ssh/*)",
      "Read(~/.gnupg/*)",
      "Read(~/.aws/*)",
      "Read(~/.config/gcloud/*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*credential*)",
      "Read(**/*password*)",
      "Edit(~/.ssh/*)",
      "Edit(~/.gnupg/*)",
      "Edit(~/.aws/*)"
    ]
  }
}

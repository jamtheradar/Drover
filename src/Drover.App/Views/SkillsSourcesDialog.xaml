<Window x:Class="Drover.App.Views.SkillsSourcesDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Skill sources"
        Width="560" Height="420"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Chrome.Background}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="GitHub repos to scan for community skills"
                       FontSize="14" FontWeight="SemiBold"
                       Foreground="{StaticResource Chrome.Text}" />
            <TextBlock Foreground="{StaticResource Chrome.TextMuted}" FontSize="11" Margin="0,4,0,0"
                       TextWrapping="Wrap">
                One per line in the form <Run FontFamily="Cascadia Code">owner/repo</Run> or
                <Run FontFamily="Cascadia Code">owner/repo@branch</Run>. Skills are
                discovered as any folder containing a <Run FontFamily="Cascadia Code">SKILL.md</Run> file.
                Lines starting with # are ignored.
            </TextBlock>
        </StackPanel>

        <TextBox Grid.Row="1" x:Name="SourcesBox"
                 AcceptsReturn="True" AcceptsTab="False"
                 VerticalScrollBarVisibility="Auto"
                 FontFamily="Cascadia Code" FontSize="12"
                 Padding="6,4" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Content="Restore defaults" Padding="10,4" Click="RestoreDefaults_Click" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Padding="14,4" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Save" Padding="14,4" IsDefault="True" Click="Save_Click"
                    Background="{StaticResource Chrome.Accent}" Foreground="White" />
        </StackPanel>
    </Grid>
</Window>

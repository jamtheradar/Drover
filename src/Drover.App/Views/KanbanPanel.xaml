<UserControl x:Class="Drover.App.Views.KanbanPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Drover.App.ViewModels"
             xmlns:m="clr-namespace:Drover.App.Models"
             xmlns:svc="clr-namespace:Drover.App.Services"
             xmlns:views="clr-namespace:Drover.App.Views"
             DataContext="{Binding DataContext.Kanban, RelativeSource={RelativeSource AncestorType=Window}}"
             Background="{StaticResource Chrome.Panel}"
             Foreground="{StaticResource Chrome.Text}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Column container — a vertical stack of cards on a slightly elevated background
             so the columns visually separate from the chrome. -->
        <Style x:Key="KanbanColumn" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Kanban.ColumnBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Chrome.Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
            <Setter Property="Padding" Value="0" />
        </Style>

        <Style x:Key="KanbanColumnHeader" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Kanban.ColumnHeaderBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Chrome.Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="10,8" />
        </Style>

        <Style x:Key="KanbanColumnHeaderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Chrome.TextMuted}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Count pill — small rounded chip carrying just the number. Sits to the right
             of the column label so the count doesn't compete with the title for weight. -->
        <Style x:Key="KanbanCountPill" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Kanban.HeaderPillBg}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="KanbanCountPillText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Kanban.HeaderPillText}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="KanbanCardTemplate" DataType="{x:Type m:KanbanCard}">
            <views:KanbanCardControl />
        </DataTemplate>

        <Style x:Key="KanbanIconButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{StaticResource Chrome.Text}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface.ControlHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header — title + source picker + refresh -->
        <Border Grid.Row="0" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,0,0,1" Padding="10,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource KanbanIconButton}"
                            Command="{Binding RefreshCommand}"
                            ToolTip="Re-enumerate cards from the active source"
                            Content="↻" />
                </StackPanel>
                <TextBlock Text="Kanban"
                           DockPanel.Dock="Left"
                           FontSize="11" FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"
                           Foreground="{StaticResource Chrome.TextMuted}" />
                <ComboBox x:Name="SourcePicker"
                          DockPanel.Dock="Left"
                          MinWidth="140"
                          SelectedValuePath="Tag"
                          SelectedValue="{Binding ActiveSource, Mode=TwoWay}"
                          ToolTip="Choose where the cards come from">
                    <ComboBoxItem Content="Local files" Tag="{x:Static svc:KanbanSourceKind.Local}" />
                    <ComboBoxItem Content="Live: TodoWrite" Tag="{x:Static svc:KanbanSourceKind.Live}" />
                    <ComboBoxItem Content="Agents" Tag="{x:Static svc:KanbanSourceKind.Agents}" />
                </ComboBox>
            </DockPanel>
        </Border>

        <!-- Four columns. Hidden when source = Agents (rail takes over). -->
        <Grid Grid.Row="1">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AgentsRailVisible}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- BACKLOG -->
            <Border Grid.Column="0" Style="{StaticResource KanbanColumn}"
                    AllowDrop="True"
                    Tag="Pending"
                    DragOver="OnColumnDragOver"
                    Drop="OnColumnDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource KanbanCountPill}">
                                <TextBlock Style="{StaticResource KanbanCountPillText}"
                                           Text="{Binding Pending.Count, Mode=OneWay}" />
                            </Border>
                            <TextBlock Style="{StaticResource KanbanColumnHeaderText}" Text="BACKLOG" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Pending}"
                                      ItemTemplate="{StaticResource KanbanCardTemplate}"
                                      Margin="6" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- PLANNED -->
            <Border Grid.Column="1" Style="{StaticResource KanbanColumn}"
                    AllowDrop="True"
                    Tag="Planned"
                    DragOver="OnColumnDragOver"
                    Drop="OnColumnDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource KanbanCountPill}">
                                <TextBlock Style="{StaticResource KanbanCountPillText}"
                                           Text="{Binding Planned.Count, Mode=OneWay}" />
                            </Border>
                            <TextBlock Style="{StaticResource KanbanColumnHeaderText}" Text="PLANNED" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Planned}"
                                      ItemTemplate="{StaticResource KanbanCardTemplate}"
                                      Margin="6" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- IN PROGRESS -->
            <Border Grid.Column="2" Style="{StaticResource KanbanColumn}"
                    AllowDrop="True"
                    Tag="InProgress"
                    DragOver="OnColumnDragOver"
                    Drop="OnColumnDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource KanbanCountPill}">
                                <TextBlock Style="{StaticResource KanbanCountPillText}"
                                           Text="{Binding InProgress.Count, Mode=OneWay}" />
                            </Border>
                            <TextBlock Style="{StaticResource KanbanColumnHeaderText}" Text="IN PROGRESS" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding InProgress}"
                                      ItemTemplate="{StaticResource KanbanCardTemplate}"
                                      Margin="6" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- DONE -->
            <Border Grid.Column="3" Style="{StaticResource KanbanColumn}"
                    BorderThickness="0"
                    AllowDrop="True"
                    Tag="Completed"
                    DragOver="OnColumnDragOver"
                    Drop="OnColumnDrop">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource KanbanCountPill}">
                                <TextBlock Style="{StaticResource KanbanCountPillText}"
                                           Text="{Binding Completed.Count, Mode=OneWay}" />
                            </Border>
                            <TextBlock Style="{StaticResource KanbanColumnHeaderText}" Text="DONE" />
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Completed}"
                                      ItemTemplate="{StaticResource KanbanCardTemplate}"
                                      Margin="6" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Agents rail. Visible only when source = Agents. Renders the same KanbanCard
             template, but in a single vertical scroll. Cards are not draggable here. -->
        <Border Grid.Row="1"
                Background="{StaticResource Kanban.AgentRailBg}"
                Padding="0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding AgentsRailVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Style="{StaticResource KanbanColumnHeader}">
                    <DockPanel>
                        <Border DockPanel.Dock="Right" Style="{StaticResource KanbanCountPill}">
                            <TextBlock Style="{StaticResource KanbanCountPillText}"
                                       Text="{Binding Pending.Count, Mode=OneWay}" />
                        </Border>
                        <TextBlock Style="{StaticResource KanbanColumnHeaderText}" Text="AGENTS" />
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Pending}"
                                  ItemTemplate="{StaticResource KanbanCardTemplate}"
                                  Margin="6" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Status line -->
        <Border Grid.Row="2" BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0" Padding="10,4">
            <TextBlock Text="{Binding StatusText}"
                       Foreground="{StaticResource Chrome.TextMuted}"
                       FontSize="10" />
        </Border>
    </Grid>
</UserControl>

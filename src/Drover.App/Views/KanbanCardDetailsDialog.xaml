<Window x:Class="Drover.App.Views.KanbanCardDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Drover.App.Models"
        xmlns:views="clr-namespace:Drover.App.Views"
        Title="Task details" Height="720" Width="720"
        MinHeight="420" MinWidth="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="{StaticResource Chrome.Panel}"
        Foreground="{StaticResource Chrome.Text}">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /> <!-- 0 Header -->
            <RowDefinition Height="Auto" /> <!-- 1 Title label -->
            <RowDefinition Height="Auto" /> <!-- 2 Title input -->
            <RowDefinition Height="Auto" /> <!-- 3 Status label -->
            <RowDefinition Height="Auto" /> <!-- 4 Status combo -->
            <RowDefinition Height="Auto" /> <!-- 5 Body label -->
            <RowDefinition x:Name="BodyRow" Height="*" /> <!-- 6 Body editor -->
            <RowDefinition x:Name="MetaRow" Height="Auto" /> <!-- 7 Sub-checklist + gates + error -->
            <RowDefinition Height="Auto" /> <!-- 8 Footer -->
        </Grid.RowDefinitions>

        <!-- Header: file path · line N -->
        <TextBlock Grid.Row="0"
                   x:Name="HeaderText"
                   Foreground="{StaticResource Chrome.TextMuted}"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12" />

        <!-- Title -->
        <TextBlock Grid.Row="1"
                   Text="Title"
                   Foreground="{StaticResource Chrome.TextMuted}"
                   FontSize="11"
                   Margin="0,0,0,4" />
        <!-- Title grows with content (wraps to multiple lines), capped so it can't push
             the rest of the dialog off-screen. Past the cap a scrollbar appears. -->
        <TextBox Grid.Row="2"
                 x:Name="TitleBox"
                 Padding="6,4"
                 TextWrapping="Wrap"
                 AcceptsReturn="False"
                 MinHeight="32"
                 MaxHeight="160"
                 VerticalScrollBarVisibility="Auto"
                 Margin="0,0,0,12"
                 VerticalContentAlignment="Top"
                 Background="{StaticResource Surface.Input}"
                 Foreground="{StaticResource Chrome.Text}"
                 BorderBrush="{StaticResource Surface.InputBorder}"
                 CaretBrush="{StaticResource Chrome.Text}"
                 SelectionBrush="{StaticResource Chrome.Accent}" />

        <!-- Status -->
        <TextBlock Grid.Row="3"
                   Text="Status"
                   Foreground="{StaticResource Chrome.TextMuted}"
                   FontSize="11"
                   Margin="0,0,0,4" />
        <ComboBox Grid.Row="4"
                  x:Name="StatusBox"
                  Width="180"
                  HorizontalAlignment="Left"
                  Margin="0,0,0,12"
                  SelectedValuePath="Tag"
                  Background="{StaticResource Surface.Input}"
                  Foreground="{StaticResource Chrome.Text}"
                  BorderBrush="{StaticResource Surface.InputBorder}">
            <ComboBoxItem Content="Backlog"     Tag="{x:Static m:KanbanStatus.Pending}"    Foreground="{StaticResource Chrome.Text}" />
            <ComboBoxItem Content="Planned"     Tag="{x:Static m:KanbanStatus.Planned}"    Foreground="{StaticResource Chrome.Text}" />
            <ComboBoxItem Content="In progress" Tag="{x:Static m:KanbanStatus.InProgress}" Foreground="{StaticResource Chrome.Text}" />
            <ComboBoxItem Content="Completed"   Tag="{x:Static m:KanbanStatus.Completed}"  Foreground="{StaticResource Chrome.Text}" />
        </ComboBox>

        <!-- Body label (heading-style cards only) -->
        <TextBlock Grid.Row="5"
                   x:Name="BodyLabel"
                   Text="Body (markdown)"
                   Foreground="{StaticResource Chrome.TextMuted}"
                   FontSize="11"
                   Margin="0,0,0,4"
                   Visibility="Collapsed" />

        <!-- Body editor — heading-style cards only. Hidden for plain list-item cards. -->
        <Border Grid.Row="6"
                x:Name="BodySection"
                Visibility="Collapsed"
                Margin="0,0,0,12"
                BorderBrush="{StaticResource Surface.InputBorder}"
                BorderThickness="1"
                CornerRadius="3"
                Background="{StaticResource Surface.Input}">
            <views:MarkdownEditor x:Name="BodyEditor" />
        </Border>

        <!-- Meta row: sub-checklist, gates, error -->
        <ScrollViewer Grid.Row="7"
                      x:Name="MetaScroll"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
                <!-- Sub-checklist — read-only summary. Use the inline checkboxes on the card to toggle. -->
                <StackPanel x:Name="SubChecklistSection" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Sub-checklist (toggle on the card)"
                               Foreground="{StaticResource Chrome.TextMuted}"
                               FontSize="11" Margin="0,0,0,4" />
                    <ItemsControl x:Name="SubChecklistList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:KanbanSubItem}">
                                <DockPanel Margin="0,2,0,0">
                                    <CheckBox IsChecked="{Binding IsDone, Mode=OneWay}"
                                              IsEnabled="False"
                                              VerticalAlignment="Center"
                                              Margin="0,0,6,0"
                                              Foreground="{StaticResource Chrome.Text}" />
                                    <TextBlock Text="{Binding Text}"
                                               TextWrapping="Wrap"
                                               Foreground="{StaticResource Chrome.Text}"
                                               FontSize="12" />
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Gates — read-only chip list -->
                <StackPanel x:Name="GatesSection" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Text="Gates"
                               Foreground="{StaticResource Chrome.TextMuted}"
                               FontSize="11" Margin="0,0,0,4" />
                    <ItemsControl x:Name="GatesList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:KanbanGate}">
                                <Border Margin="0,0,4,4"
                                        Padding="6,2"
                                        CornerRadius="3"
                                        BorderThickness="1"
                                        ToolTip="{Binding Detail}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource Kanban.GatePending}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource Kanban.GatePending}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Passed}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource Kanban.GateOk}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Kanban.GateOk}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Passed}" Value="False">
                                                    <Setter Property="Background" Value="{StaticResource Kanban.GateBlocked}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource Kanban.GateBlocked}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Kind}"
                                               Foreground="White"
                                               FontSize="10"
                                               FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <TextBlock x:Name="ErrorText"
                           Foreground="{StaticResource Kanban.GateBlocked}"
                           FontSize="11"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Margin="0,0,0,8" />
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <DockPanel Grid.Row="8" Margin="0,12,0,0">
            <Button DockPanel.Dock="Left"
                    Content="Open file…"
                    Padding="10,4"
                    Click="Open_Click"
                    Foreground="{StaticResource Chrome.Text}"
                    ToolTip="Open the source file in your default editor" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="12,4" Margin="0,0,8,0" IsCancel="True"
                        Foreground="{StaticResource Chrome.Text}" />
                <Button Content="Save"   Padding="12,4" IsDefault="True" Click="Save_Click"
                        Foreground="{StaticResource Chrome.Text}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>

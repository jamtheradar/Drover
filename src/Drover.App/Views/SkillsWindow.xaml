<Window x:Class="Drover.App.Views.SkillsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Drover.App.ViewModels"
        xmlns:views="clr-namespace:Drover.App.Views"
        Title="Add skill"
        Width="980" Height="640"
        MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Chrome.Background}">
    <Window.Resources>
        <views:SourceToGithubUriConverter x:Key="SourceToGithubUri" />
        <Style x:Key="ListItemStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="SkillListItem">
            <StackPanel>
                <TextBlock Text="{Binding Name}" FontSize="13"
                           Foreground="{StaticResource Chrome.Text}" />
                <DockPanel Margin="0,2,0,0" LastChildFill="True">
                    <Border DockPanel.Dock="Left"
                            Background="{StaticResource Chrome.Border}"
                            CornerRadius="3" Padding="5,1" Margin="0,0,6,0">
                        <TextBlock Text="{Binding Category}" FontSize="10"
                                   Foreground="{StaticResource Chrome.TextMuted}" />
                    </Border>
                    <TextBlock Text="{Binding Source}" FontSize="10"
                               Foreground="{StaticResource Chrome.TextMuted}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                </DockPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <Button DockPanel.Dock="Right" Content="Refresh" Padding="10,4"
                    Click="Refresh_Click" />
            <Button DockPanel.Dock="Right" Content="Sources…" Padding="10,4" Margin="0,0,6,0"
                    Click="Sources_Click" />
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18"
                           Foreground="{StaticResource Chrome.Text}" FontWeight="SemiBold" />
                <TextBlock Text="Browse community Claude Code skills indexed from GitHub. Install copies the folder into ~/.claude/skills."
                           Foreground="{StaticResource Chrome.TextMuted}" FontSize="11"
                           Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="1" Margin="0,0,0,8" LastChildFill="True">
            <ComboBox DockPanel.Dock="Right" Width="180" Margin="8,0,0,0"
                      ItemsSource="{Binding Categories}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      ToolTip="Filter by category" />
            <TextBox Padding="6,4"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=120}"
                     ToolTip="Search by name, description, source, or category" />
        </DockPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="{StaticResource Chrome.Border}"
                    BorderThickness="0,0,1,0">
                <Grid>
                    <ListBox ItemsSource="{Binding SkillsView}"
                             SelectedItem="{Binding SelectedSkill, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource ListItemStyle}"
                             ItemTemplate="{StaticResource SkillListItem}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                    <TextBlock x:Name="StatusOverlay"
                               Foreground="{StaticResource Chrome.TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" Visibility="Collapsed"
                               TextWrapping="Wrap" Margin="20" TextAlignment="Center" />
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="3" HorizontalAlignment="Stretch"
                          Background="{StaticResource Chrome.Border}" />
            <Grid Grid.Column="2" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSkill}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Hidden" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <TextBlock Grid.Row="0" Text="{Binding SelectedSkill.Name}"
                           FontSize="20" FontWeight="SemiBold"
                           Foreground="{StaticResource Chrome.Text}"
                           TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Margin="0,6,0,0">
                    <Hyperlink NavigateUri="{Binding SelectedSkill.SourceUrl}"
                               RequestNavigate="Source_RequestNavigate">
                        <Run Text="{Binding SelectedSkill.Source}" />
                    </Hyperlink>
                </TextBlock>
                <TextBlock Grid.Row="2" Margin="0,4,0,0"
                           Foreground="{StaticResource Chrome.TextMuted}" FontSize="11"
                           Text="{Binding SelectedSkill.Category, StringFormat='Category: {0}'}" />
                <ScrollViewer Grid.Row="3" Margin="0,12,0,0"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock Text="{Binding SelectedSkill.Description}"
                               Foreground="{StaticResource Chrome.Text}"
                               TextWrapping="Wrap" FontSize="13" />
                </ScrollViewer>
                <CheckBox Grid.Row="4" Margin="0,12,0,0"
                          Content="Install globally (-g)"
                          Foreground="{StaticResource Chrome.Text}"
                          IsChecked="{Binding InstallGlobally, Mode=TwoWay}" />
                <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Content="Install" Padding="14,6" FontWeight="SemiBold"
                            Background="{StaticResource Chrome.Accent}"
                            Foreground="White"
                            Command="{Binding InstallCommand}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Margin="0,12,0,0" Padding="0,8,0,0"
                BorderBrush="{StaticResource Chrome.Border}" BorderThickness="0,1,0,0">
            <TextBlock x:Name="StatusLine" Text="{Binding StatusText}"
                       Foreground="{StaticResource Chrome.TextMuted}" FontSize="11" />
        </Border>
    </Grid>
</Window>
